generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String
  phone            String
  role             String            // FARMER, CONSUMER, BULK_BUYER, ADMIN
  location         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  farmerProfile    FarmerProfile?
  consumerProfile  ConsumerProfile?
  buyerProfile     BulkBuyerProfile?
  products         Product[]         @relation("FarmerProducts")
  ordersPlaced     Order[]           @relation("BuyerOrders")
  ordersReceived   Order[]           @relation("FarmerOrders")
  cart             Cart?
  reviews          Review[]
  sentMessages     Message[]         @relation("SentMessages")
  receivedMessages Message[]         @relation("ReceivedMessages")
  notifications    Notification[]
  bulkRequests     BulkRequest[]
  farmerOffers     FarmerOffer[]
  favorites        Favorite[]
  farmerDeliveries Delivery[]        @relation("FarmerDeliveries")
  consumerDeliveries Delivery[]      @relation("ConsumerDeliveries")
}

model FarmerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName         String
  farmLocation     String
  organicCertified Boolean  @default(false)
  farmingType      String   @default("Organic & Traditional")
  bio              String?
  rating           Float    @default(4.8)
  totalSales       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ConsumerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCategory String?
  addressLine       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BulkBuyerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String
  businessType     String
  requiredProducts String?
  expectedQuantity String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  icon      String
  slug      String    @unique
  products  Product[]
}

model Product {
  id                String          @id @default(uuid())
  farmerId          String
  farmer            User            @relation("FarmerProducts", fields: [farmerId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  name              String
  description       String
  price             Float
  quantity          Float
  unit              String          @default("kg")
  location          String
  harvestDate       String
  organic           Boolean         @default(true)
  deliveryAvailable Boolean         @default(true)
  pickupAvailable   Boolean         @default(true)
  image             String
  rating            Float           @default(4.5)
  salesCount        Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  cartItems         CartItem[]
  orderItems        OrderItem[]
  reviews           Review[]
  messages          Message[]
  priceHistory      PriceHistory[]
  demandForecasts   DemandForecast[]
  favorites         Favorite[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float    @default(1.0)
  createdAt DateTime @default(now())
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmerId        String
  farmer          User        @relation("FarmerOrders", fields: [farmerId], references: [id])
  totalAmount     Float
  status          String      @default("PENDING") // PENDING, CONFIRMED, PREPARING, READY_FOR_PICKUP, PICKED_UP, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentMethod   String      @default("UPI")
  shippingAddress String
  deliveryType    String      @default("DELIVERY")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  payment         Payment?
  delivery        Delivery?
  reviews         Review[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  price     Float
  unit      String   @default("kg")
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId String   @unique
  status        String   @default("COMPLETED")
  amount        Float
  method        String   @default("UPI")
  paidAt        DateTime @default(now())
}

model Delivery {
  id               String   @id @default(uuid())
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  farmerId         String
  farmer           User     @relation("FarmerDeliveries", fields: [farmerId], references: [id])
  consumerId       String
  consumer         User     @relation("ConsumerDeliveries", fields: [consumerId], references: [id])
  pickupLocation   String
  deliveryLocation String
  status           String   @default("ASSIGNED")
  distanceKm       Float    @default(12.5)
  estimatedMins    Int      @default(35)
  routeDetails     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // ORDER, PAYMENT, DISPATCH, DELIVERY, DEMAND, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PriceHistory {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  farmConnectPrice Float
  localMarketPrice Float
  retailPrice      Float
  recordedAt       DateTime @default(now())
}

model DemandForecast {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  historicalDate  String
  quantitySold    Float
  predictedDemand Float
  confidenceScore Float    @default(0.92)
}

model BulkRequest {
  id           String        @id @default(uuid())
  buyerId      String
  buyer        User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productName  String
  quantity     Float
  unit         String        @default("kg")
  requiredDate String
  targetPrice  Float
  location     String
  status       String        @default("OPEN") // OPEN, IN_NEGOTIATION, CLOSED, CANCELLED
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  offers       FarmerOffer[]
}

model FarmerOffer {
  id            String      @id @default(uuid())
  bulkRequestId String
  bulkRequest   BulkRequest @relation(fields: [bulkRequestId], references: [id], onDelete: Cascade)
  farmerId      String
  farmer        User        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  offeredQuantity Float
  pricePerUnit  Float
  deliveryDate  String
  note          String?
  status        String      @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime    @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
